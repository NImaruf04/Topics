void solve()
{
    int n;cin>>n;
    string s;
    cin>>s;
    string r=s;
    reverse(r.begin(),r.end());
    map<char,queue<int>>pos_s,pos_r;
    for(int i=0;i<n;i++){
        pos_s[s[i]].push(i);
        pos_r[r[i]].push(i);
    }
    // map<char,vector<int>>pos_s,pos_r;
    // for(int i=0;i<n;i++){
    //     pos_s[s[i]].push_back(i);
    //     pos_r[r[i]].push_back(i);
    // }
    vector<int>permutation(n);
    for(int i=0;i<n;i++){
        permutation[i]=pos_s[r[i]].front();
        pos_s[r[i]].pop();
    }
    // for(char ch='a';ch<='z';ch++){
    // for(int i=0;i<pos_s[ch].size();i++){
    //    permutation[pos_r[ch][i]]=pos_s[ch][i];
    // }}
    // for(auto xx:permutation)cout<<xx<<" ";
    // cout<<endl;
    pbds<int>p;
    int res=0;
    for(int i=n-1;i>=0;i--){
      p.insert(permutation[i]);
      res+=p.order_of_key(permutation[i]);
    }
    cout<<res<<endl;
}
