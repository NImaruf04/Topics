void solve()
{
    int n, m, d;
    cin >> n >> m >> d;
    vector<int> v(n * m);
    for (int i = 0; i < (n * m); i++)
        cin >> v[i];
    sort(v.begin(), v.end());

    int st = 0, en = v.size() - 1;
    bool tr = 0;
    int res = imax;
    while (st <= en)
    {
        int mid1 = st + (en - st) / 3;
        int mid2 = en - (en - st) / 3;

        int pos = mid1;
        int cnt = 0;
        bool tr = 0;
        for (int i = 0; i < pos; i++)
        {
            if ((v[pos] - v[i]) % d != 0)
                tr = 1;
            else
                cnt += ((v[pos] - v[i]) / d);
        }
        for (int i = pos + 1; i < n * m; i++)
        {
            if ((v[i] - v[pos]) % d != 0)
                tr = 1;
            else
                cnt += ((v[i] - v[pos]) / d);
        }
        if (tr)
        {
            cout << -1 << endl;
            return;
        }
        pos = mid2;
        int cnt2 = 0;
        tr = 0;
        for (int i = 0; i < pos; i++)
        {
            if ((v[pos] - v[i]) % d != 0)
                tr = 1;
            else
                cnt2 += ((v[pos] - v[i]) / d);
        }
        for (int i = pos + 1; i < n * m; i++)
        {
            if ((v[i] - v[pos]) % d != 0)
                tr = 1;
            else
                cnt2 += ((v[i] - v[pos]) / d);
        }
        if (tr)
        {
            cout << -1 << endl;
            return;
        }
        if (cnt <= cnt2)
        {
            en = mid2 - 1;
            res = min(res, cnt);
        }
        else
        {
            st = mid1 + 1;
            res = min(res, cnt2);
        }
    }
    cout << res << endl;
}
