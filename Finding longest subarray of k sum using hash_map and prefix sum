void solve()
{
    int n, e;
    cin >> n >> e;
    int ar[n];
    for (int i = 0; i < n; i++)
        cin >> ar[i];
    //finding longest subarray of totol sum=k using -
    //hash_map and prefix sum
    unordered_map<int, int> m;
    int pr = 0, res = 0;
    for (int i = 0; i < n; i++)
    {
        pr += ar[i];
        if (pr == e)
            res = i + 1;
        else if (m.find(pr - e) != m.end())
        {
            res = max(res, i - m[pr - e]);
        }
        else if(m.find(pr-e)==m.end()){
            m[pr]=i;
        }
    }
    cout<<res<<endl;
}
